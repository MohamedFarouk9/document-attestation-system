# ============================================================
# Document Attestation System — Environment Variables
# ============================================================
# Copy to .env and fill in values. All variables with defaults
# work out of the box for local Docker Compose development.
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attestation?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO / S3 ---
S3_ENDPOINT=http://localhost
S3_PORT=9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_USE_SSL=false
# For production AWS S3, set:
# S3_ENDPOINT=https://s3.me-south-1.amazonaws.com
# S3_PORT=443
# S3_USE_SSL=true
# S3_BUCKET=your-production-bucket

# --- Authentication ---
JWT_SECRET=dev-jwt-secret-CHANGE-IN-PRODUCTION
JWT_REFRESH_SECRET=dev-refresh-secret-CHANGE-IN-PRODUCTION
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Payment ---
# Which gateway to use: mock | paymob | fawry
PAYMENT_GATEWAY=mock
# Paymob (fill when sandbox account is ready)
# PAYMOB_API_KEY=
# PAYMOB_HMAC_SECRET=
# PAYMOB_INTEGRATION_ID_CARD=
# PAYMOB_INTEGRATION_ID_WALLET=
# PAYMOB_IFRAME_ID=
# Fawry (fill when sandbox account is ready)
# FAWRY_MERCHANT_CODE=
# FAWRY_SECURITY_KEY=
# FAWRY_BASE_URL=https://atfawry.fawrystaging.com

# --- Notifications ---
# Channels to enable: email,inapp (comma-separated)
NOTIFICATION_CHANNELS=inapp
# Email (SMTP) — fill when email provider is ready
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@attestation.example.com

# --- Application ---
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001
DEFAULT_LOCALE=ar
NODE_ENV=development

# --- Observability ---
LOG_LEVEL=debug
# Set to 'true' to enable pretty-printed logs in development
LOG_PRETTY=true
